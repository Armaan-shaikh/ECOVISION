# EcoVision Safe Environment Template
# Copy to .env for local overrides (never commit .env)

FLASK_ENV=development
FLASK_DEBUG=False
PORT=5000
HOST=127.0.0.1
DATABASE_PATH=ecovision.db

# In development, local Vite dev servers are allowed.
# In production, set to comma-separated domains (e.g. https://ecovision.example.com).
# Wildcard '*' is strictly prohibited in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cryptographic Secret Key (set a secure random string in production)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-in-production-use-a-strong-random-key

# Maximum request body size (bytes) - default 1MB
MAX_CONTENT_LENGTH=1048576

# API Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=60/minute
RATELIMIT_ML=10/minute
